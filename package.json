{
  "name": "craftcv",
  "version": "0.1.0",
  "description": "Local-first, evidence-backed CV tailoring",
  "license": "MIT",
  "author": "CraftCV contributors",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishdev20/craftcv.git"
  },
  "bugs": {
    "url": "https://github.com/fishdev20/craftcv/issues"
  },
  "homepage": "https://github.com/fishdev20/craftcv#readme",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:onboarding": "electron-vite dev --watch --mode onboarding",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "npm run build && node scripts/integration.mjs && node scripts/editor-integration.mjs && node scripts/folder-integration.mjs",
    "context:check": "node scripts/check-agent-context.mjs",
    "check": "npm run format:check && npm run context:check && npm run security:check && npm run typecheck && npm run lint && npm test && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run check && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "measure": "node scripts/measure.mjs",
    "security:check": "node scripts/check-workflow-actions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@iconify-icons/lucide": "2.0.28",
    "@iconify-icons/simple-icons": "2.0.8",
    "@iconify/react": "6.0.4",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/extension-text-style": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "better-sqlite3": "13.0.3",
    "docx": "9.15.3",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
